{
  "id": "wf-basic-7block",
  "name": "基本7block分块（4个LoRA位）",
  "description": "基于基本无污染带lora工作流拆分。7个独立CLIP节点（画风/角色/衣服/动作/表情/场景/镜头）通过ConditioningCombine合并，4个LoRA Slot。",
  "created": "2026-02-21",
  "blockSlots": {
    "style": "100",
    "character": "101",
    "clothing": "102",
    "action": "103",
    "expression": "104",
    "scene": "105",
    "camera": "106"
  },
  "negativeSlot": "7",
  "checkpointSlot": { "nodeId": "4", "field": "inputs.ckpt_name" },
  "loraSlots": [
    { "nodeId": "11", "filenameField": "inputs.lora_name", "weightField": "inputs.strength_model" },
    { "nodeId": "12", "filenameField": "inputs.lora_name", "weightField": "inputs.strength_model" },
    { "nodeId": "13", "filenameField": "inputs.lora_name", "weightField": "inputs.strength_model" },
    { "nodeId": "14", "filenameField": "inputs.lora_name", "weightField": "inputs.strength_model" }
  ],
  "otherParams": [
    { "name": "Seed", "nodeId": "3", "field": "inputs.seed", "type": "number", "default": 0 },
    { "name": "Steps", "nodeId": "3", "field": "inputs.steps", "type": "number", "default": 26 },
    { "name": "CFG", "nodeId": "3", "field": "inputs.cfg", "type": "number", "default": 8 },
    { "name": "Sampler", "nodeId": "3", "field": "inputs.sampler_name", "type": "string", "default": "euler" },
    { "name": "Scheduler", "nodeId": "3", "field": "inputs.scheduler", "type": "string", "default": "normal" },
    { "name": "Denoise", "nodeId": "3", "field": "inputs.denoise", "type": "number", "default": 1 },
    { "name": "Width", "nodeId": "5", "field": "inputs.width", "type": "number", "default": 1200 },
    { "name": "Height", "nodeId": "5", "field": "inputs.height", "type": "number", "default": 1920 }
  ],
  "rawWorkflow": {
    "3": {
      "class_type": "KSampler",
      "inputs": {
        "model": ["14", 0],
        "positive": ["115", 0],
        "negative": ["7", 0],
        "latent_image": ["5", 0],
        "seed": 0,
        "steps": 26,
        "cfg": 8,
        "sampler_name": "euler",
        "scheduler": "normal",
        "denoise": 1
      },
      "_meta": { "title": "KSampler" }
    },
    "4": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "waiIllustriousSDXL_v150.safetensors"
      },
      "_meta": { "title": "Checkpoint加载器" }
    },
    "5": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "width": 1200,
        "height": 1920,
        "batch_size": 1
      },
      "_meta": { "title": "空Latent图像" }
    },
    "7": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": ["14", 1],
        "text": "EasyNegativeV2,neghand,NegfeetV2,(low quality, worst quality:1.4), (blurry:1.2), (bad anatomy:1.3), extra limbs, deformed, watermark, text, signature, extra fingers, mutated hands, bad hands, malformed hands, long fingers, fused fingers, missing fingers, (extra legs:1.2, extra foot:1.2, extra feet, multiple legs, multiple feet, extra limb, extra body parts, fused legs, malformed legs, deformed feet),"
      },
      "_meta": { "title": "负面Negative" }
    },
    "8": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["3", 0],
        "vae": ["4", 2]
      },
      "_meta": { "title": "VAE解码" }
    },
    "9": {
      "class_type": "SaveImage",
      "inputs": {
        "images": ["8", 0],
        "filename_prefix": "ComfyUI"
      },
      "_meta": { "title": "保存图像" }
    },
    "11": {
      "class_type": "LoraLoader",
      "inputs": {
        "model": ["4", 0],
        "clip": ["4", 1],
        "lora_name": "",
        "strength_model": 0.6,
        "strength_clip": 1
      },
      "_meta": { "title": "LoRA #1" }
    },
    "12": {
      "class_type": "LoraLoader",
      "inputs": {
        "model": ["11", 0],
        "clip": ["11", 1],
        "lora_name": "",
        "strength_model": 1,
        "strength_clip": 1
      },
      "_meta": { "title": "LoRA #2" }
    },
    "13": {
      "class_type": "LoraLoader",
      "inputs": {
        "model": ["12", 0],
        "clip": ["12", 1],
        "lora_name": "",
        "strength_model": 1,
        "strength_clip": 1
      },
      "_meta": { "title": "LoRA #3" }
    },
    "14": {
      "class_type": "LoraLoader",
      "inputs": {
        "model": ["13", 0],
        "clip": ["13", 1],
        "lora_name": "",
        "strength_model": 1,
        "strength_clip": 1
      },
      "_meta": { "title": "LoRA #4" }
    },

    "100": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": ["14", 1],
        "text": ""
      },
      "_meta": { "title": "画风 Style" }
    },
    "101": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": ["14", 1],
        "text": ""
      },
      "_meta": { "title": "角色 Character" }
    },
    "102": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": ["14", 1],
        "text": ""
      },
      "_meta": { "title": "衣服 Clothing" }
    },
    "103": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": ["14", 1],
        "text": ""
      },
      "_meta": { "title": "动作 Action" }
    },
    "104": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": ["14", 1],
        "text": ""
      },
      "_meta": { "title": "表情 Expression" }
    },
    "105": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": ["14", 1],
        "text": ""
      },
      "_meta": { "title": "场景 Scene" }
    },
    "106": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": ["14", 1],
        "text": ""
      },
      "_meta": { "title": "镜头 Camera" }
    },

    "110": {
      "class_type": "ConditioningCombine",
      "inputs": {
        "conditioning_1": ["100", 0],
        "conditioning_2": ["101", 0]
      },
      "_meta": { "title": "合并: 画风+角色" }
    },
    "111": {
      "class_type": "ConditioningCombine",
      "inputs": {
        "conditioning_1": ["110", 0],
        "conditioning_2": ["102", 0]
      },
      "_meta": { "title": "合并: +衣服" }
    },
    "112": {
      "class_type": "ConditioningCombine",
      "inputs": {
        "conditioning_1": ["111", 0],
        "conditioning_2": ["103", 0]
      },
      "_meta": { "title": "合并: +动作" }
    },
    "113": {
      "class_type": "ConditioningCombine",
      "inputs": {
        "conditioning_1": ["112", 0],
        "conditioning_2": ["104", 0]
      },
      "_meta": { "title": "合并: +表情" }
    },
    "114": {
      "class_type": "ConditioningCombine",
      "inputs": {
        "conditioning_1": ["113", 0],
        "conditioning_2": ["105", 0]
      },
      "_meta": { "title": "合并: +场景" }
    },
    "115": {
      "class_type": "ConditioningCombine",
      "inputs": {
        "conditioning_1": ["114", 0],
        "conditioning_2": ["106", 0]
      },
      "_meta": { "title": "合并: +镜头 → KSampler" }
    }
  }
}
