{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-illustrate/schemas/render_job.v1.json",
  "title": "RenderJob v1",
  "description": "NAI 出图终端统一工单。1 job = 1 套图（队列项），frames[] 内含全部帧、samples[] 内 seed 已由 emitter 预展开固定。所有 object 均 additionalProperties:false=未知字段拒绝。model/sampler/noise_schedule 白名单=语义校验，权威源在 tools/job_emitter.py 的共享常量，emitter 与终端 worker 双端各校一次（schema 只做结构校验，避免 NAI 加模型即改 schema 版本）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "idempotency_key", "display_name", "augmentation", "output", "clean", "limits", "frames"],
  "properties": {
    "schema_version": { "const": "render_job.v1" },
    "job_id": {
      "type": "string",
      "description": "UUIDv7 小写。有意重跑同一内容时必须生成新 job_id。",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "idempotency_key": {
      "type": "string",
      "description": "sha256:<64hex>。算法=JCS(RFC8785) 规范化后 SHA-256，参与字段见 emitter canonicalize_job（排除本字段与 submitted_at/emitter_version）。",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "display_name": {
      "type": "string",
      "description": "队列显示名，emitter 默认取逻辑输出路径末段（=评分系统同款文件夹名）。",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[^\\u0000-\\u001f]+$"
    },
    "augmentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preset_id", "extras", "global_layer", "private_content"],
      "properties": {
        "preset_id": {
          "type": ["string", "null"],
          "description": "公开壳中存在且 enabled 的预设 id；无效必须拒单，禁止回落首个预设。v1.1: null=无加装（2026-07-13）——null 时 extras 必须为空数组、char_layer_assign 仍允许。",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[^\\u0000-\\u001f]+$"
        },
        "extras": {
          "type": "array",
          "description": "套图级特殊栏，公开稳定 ID 精确匹配（禁子串命中）；响应逐项回 matched/injected/not_found。",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[^\\u0000-\\u001f]+$" }
        },
        "global_layer": { "type": "boolean", "description": "是否执行全局删除→全局替换（期一恒 true 透传，期二接实现）。" },
        "private_content": { "const": "__TERMINAL_PRIVATE__", "description": "公开契约占位，禁止携带任何实际文本。" },
        "char_layer_assign": {
          "type": "object",
          "description": "【过渡字段·期二随 character_layers 废除】槽位(0-based 字符串)→角色加装层 layerId；view 由 characters[].view 派生，不另传。",
          "additionalProperties": false,
          "maxProperties": 16,
          "patternProperties": {
            "^(0|[1-9][0-9]?)$": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[^\\u0000-\\u001f]+$" }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "relative_path", "collision_policy"],
      "properties": {
        "root": { "const": "workspace", "description": "v1 只允许 workspace 逻辑根；终端自行映射物理路径并 resolve() 复核仍在根内。" },
        "relative_path": {
          "type": "string",
          "description": "/ 分隔相对路径；禁绝对路径/盘符/UNC/./../空段/反斜杠/冒号。",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^(?!\\.{1,2}(/|$))[^/\\\\:\\u0000-\\u001f]+((/)(?!\\.{1,2}(/|$))[^/\\\\:\\u0000-\\u001f]+)*$"
        },
        "collision_policy": { "enum": ["fail", "append_suffix"], "description": "默认不覆盖旧图。" }
      }
    },
    "clean": { "type": "boolean", "description": "v1 兼容字段；不控制执行。Clean 只服从终端 App 的二态开关。" },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_images", "max_anlas"],
      "properties": {
        "max_images": { "type": "integer", "minimum": 1, "maximum": 4000, "description": "必须 == Σ frames[].samples.length（接收端跨字段校验）。" },
        "max_anlas": { "type": "integer", "minimum": 0, "maximum": 100000, "description": "保守预估超限=整单拒绝+报告 Owner（第五轮 §20 定案），终端不自作主张砍量。" }
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/frame" }
    },
    "submitted_at": { "type": "string", "format": "date-time", "description": "仅审计，不参与幂等键。emitter 写 UTC。" },
    "emitter_version": { "type": "string", "maxLength": 120, "description": "仅审计（如 git commit），不参与幂等键。" }
  },
  "$defs": {
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_id", "output_name", "prompt", "generation", "samples"],
      "properties": {
        "frame_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$", "description": "全工单唯一（接收端校验）。" },
        "output_name": {
          "type": "string",
          "description": "安全文件名前缀，不含路径字符。",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^(?!\\.{1,2}$)[^/\\\\:*?\"<>|\\u0000-\\u001f]+$"
        },
        "prompt": { "$ref": "#/$defs/prompt" },
        "generation": { "$ref": "#/$defs/generation" },
        "samples": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/sample" },
          "description": "张数 = samples.length（废 seed+count 含糊语义）；sample_id 帧内唯一（接收端校验）。"
        },
        "char_reference": { "$ref": "#/$defs/charReference" }
      }
    },
    "charReference": {
      "type": "object",
      "additionalProperties": false,
      "description": "显式公开角色参考（webapp 手动挡/CLI --char-ref 语义，用户自选图=非隐私）。与预设内加密参考(char_references[])互斥关系沿用现行三级优先链：显式>augment>char_layers。每帧单参考；带参考的每张 sample 计 ~5 Anlas。",
      "required": ["image_b64", "strength", "fidelity", "mode"],
      "properties": {
        "image_b64": { "type": "string", "minLength": 1, "maxLength": 8000000, "pattern": "^[A-Za-z0-9+/=]+$" },
        "strength": { "type": "number", "minimum": 0, "maximum": 2 },
        "fidelity": { "type": "number", "minimum": 0, "maximum": 2 },
        "mode": { "enum": ["character&style", "character", "style"] }
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_positive", "base_negative", "characters"],
      "properties": {
        "base_positive": { "$ref": "#/$defs/promptText", "description": "加装前公开正向全文（隐私处不出现——加装由终端按 preset_id 完成）。" },
        "base_negative": { "$ref": "#/$defs/promptText", "description": "最终公开负向全文，必须显式给出，不依赖终端默认。" },
        "characters": {
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/character" },
          "description": "顺序即 NAI 角色槽顺序（女角在前、男角末槽的排槽铁律由 emitter 侧 runner 保证）。"
        }
      }
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot_id", "caption", "negative", "center", "view"],
      "properties": {
        "slot_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$", "description": "帧内唯一稳定 ID（如 char_0），外部身份不用数组下标。" },
        "caption": { "$ref": "#/$defs/promptText" },
        "negative": { "$ref": "#/$defs/promptText" },
        "center": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "number", "minimum": 0, "maximum": 1 },
            "y": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "view": {
          "enum": ["front_full", "front_cowboy", "front_upper", "front_mid", "front_lower", "back_full", "back_cowboy", "back_upper", "back_mid", "back_lower"],
          "description": "终端据此决定正面栏注入与否（back_*×5+front_lower 不注入）与参考图正/反面选择。"
        },
        "cast_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,15}$",
          "description": "如 f1/f2，私设角色门控用；帧内唯一。终端由此派生 cast，不另传独立 cast[]。男角/不参与 persona 的槽省略。"
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "width", "height", "steps", "sampler", "scale", "cfg_rescale", "noise_schedule", "variety_plus", "auto_position", "quality_toggle", "uc_preset"],
      "description": "此帧完整生效参数，全部显式；终端禁止偷偷合并自身默认（配置一改工单必须仍可复现）。",
      "properties": {
        "model": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z0-9][a-z0-9._-]*$", "description": "白名单=emitter/worker 共享常量 ALLOWED_MODELS。" },
        "width": { "type": "integer", "minimum": 64, "maximum": 3072, "multipleOf": 64 },
        "height": { "type": "integer", "minimum": 64, "maximum": 3072, "multipleOf": 64 },
        "steps": { "type": "integer", "minimum": 1, "maximum": 50 },
        "sampler": { "type": "string", "minLength": 1, "maxLength": 60, "pattern": "^[a-z0-9_]+$", "description": "白名单=共享常量 ALLOWED_SAMPLERS。" },
        "scale": { "type": "number", "minimum": 0, "maximum": 30 },
        "cfg_rescale": { "type": "number", "minimum": 0, "maximum": 1 },
        "noise_schedule": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[a-z0-9_]+$", "description": "白名单=共享常量 ALLOWED_NOISE_SCHEDULES；V4 系强制 karras 由语义校验把关。" },
        "variety_plus": { "type": "boolean" },
        "auto_position": { "type": "boolean" },
        "quality_toggle": { "type": "boolean" },
        "uc_preset": { "type": "integer", "minimum": 0, "maximum": 5 },
        "advanced": { "$ref": "#/$defs/advanced" }
      }
    },
    "advanced": {
      "type": "object",
      "additionalProperties": false,
      "description": "高级采样透传白名单（与 submit_nai ADV_PASSTHROUGH 对齐）；仅显式提供才转发。",
      "properties": {
        "prefer_brownian": { "type": "boolean" },
        "deliberate_euler_ancestral_bug": { "type": "boolean" },
        "cfg_sched_eligibility": { "type": "string", "maxLength": 40 },
        "skip_cfg_above_sigma": { "type": ["number", "null"] },
        "skip_cfg_below_sigma": { "type": ["number", "null"] },
        "legacy_v3_extend": { "type": "boolean" },
        "dynamic_thresholding_percentile": { "type": "number" },
        "dynamic_thresholding_mimic_scale": { "type": "number" },
        "explike_fine_detail": { "type": "boolean" },
        "minimize_sigma_inf": { "type": "boolean" },
        "uncond_per_vibe": { "type": "boolean" },
        "wonky_vibe_correlation": { "type": "boolean" }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_id", "seed"],
      "properties": {
        "sample_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$" },
        "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295, "description": "emitter 投递前展开固定（随机 seed 也在 emitter 生成写死），终端不再随机。" }
      }
    },
    "promptText": {
      "type": "string",
      "maxLength": 40000,
      "description": "允许 \\t \\n \\r，拒绝其余控制字符与 NUL。",
      "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]*$"
    }
  }
}
